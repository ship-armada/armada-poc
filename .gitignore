# Dependencies
node_modules/
.venv/

# Hardhat
artifacts/
cache/
typechain-types/

# Foundry
out/
forge-out/
broadcast/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
*.env
.env.local
.env.*.local

# Config env files with secrets (templates are committed with empty keys)
config/*.env.local
config/secrets.env

# Committed env templates (no secrets — deployer key/RPCs are sourced from secrets.env)
!config/local.env
!config/sepolia.env
!config/mainnet.env

# Local deployment artifacts (regenerated by npm run setup)
deployments/*.json
!deployments/*-sepolia*.json

# Named deployment instances pulled from the armada-deployments repo by
# `npm run fetch-deployment -- <name>`. Each instance is reproducible from the
# upstream repo, so we never commit local copies.
deployments/instances/

# Build-time-fetched manifest copies (Netlify pulls these from armada-deployments
# at build time per apps/armada-interface/netlify.toml; never commit them)
apps/armada-interface/public/api/

# ZK circuit artifacts (large binaries — download separately or build locally)
usdc-v2-frontend/public/masp/
*.params
*.zkey

# Railgun SDK database
data/

# Relayer per-chain scan cursors (file-backed state for crash recovery). Ignore the cursor
# files themselves but keep the directory + its README in version control so a fresh clone
# has the docs explaining the cursor format.
relayer/state/*
!relayer/state/README.md

# Logs
*.log

# Secrets and credentials
*.key
*.pem
*.secret
*.wallet
*.keystore
# Key-material fixtures — never recreate a committed wallets/ dir (old one lives in _legacy/)
/wallets/
*.wallet.json

# OS
.DS_Store
._*
*.swp
Thumbs.db

# Local chain data
nodes/
