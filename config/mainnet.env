# Mainnet Production Environment
# Usage: source config/mainnet.env && <deploy command>
#
# SCOPE: The crowdfund/governance launch is HUB-ONLY (Ethereum mainnet). Client
# chains (Base, Arbitrum) are configured here for the later shielded-pool deploy
# and are not exercised by the crowdfund launch.
#
# BEFORE LAUNCH, fill every value marked "TODO (required before launch)".
# Items left as commented TODO placeholders will make the deploy fail loud
# (missing deployer key / security council / launch team / initial steward /
# reserve allocator / beneficiaries), which is intentional — a misconfigured mainnet deploy must halt,
# not proceed.
#
# Related tracking issues:
#   #347 — mainnet timelock bootstrap (delay-0→raise + renounce); profile flag TBD
#   #348 — finalize treasury outflow limit values
#   #349 — PrivacyPool ownership / key custody (shielded-pool launch)
#   #144 — finalize RevenueLock beneficiary list
#   #582 — revenue reserve allocator Safe + cap (required; immutable once deployed)
#   #221 / #222 — initial steward elected + USDC steward budget seeded at deploy
#   #381 — wind-down deadline (C2): fixed at this deploy, set below to 2027-12-31
#   #537 — gas headroom + no re-run: a launch that stops part-way is recovered by
#          hand per docs/interrupted-launch-recovery.md, never by re-running

# Load secrets (deployer private key, production RPC URLs with API keys) from gitignored file
if [ -f "config/secrets.env" ]; then
  source "config/secrets.env"
else
  echo "WARNING: config/secrets.env not found. Copy config/secrets.env.template and add your key."
fi

# Environment identifier
export DEPLOY_ENV=mainnet

# CCTP mode: must be "real" on mainnet (enforced in config/networks.ts)
export CCTP_MODE=real

# ============================================================================
# Chains
# ============================================================================
# Public RPC fallbacks are keyless and last-resort. For production reliability,
# override HUB_RPC / CLIENT_1_RPC / CLIENT_2_RPC with a private endpoint in
# config/secrets.env (NOT here — those URLs embed API keys). secrets.env is sourced
# first; the ${VAR:-default} guards below keep its value instead of overwriting it.

# Hub chain: Ethereum mainnet
export HUB_RPC=${HUB_RPC:-https://ethereum-rpc.publicnode.com}
export HUB_CHAIN_ID=1
export HUB_CCTP_DOMAIN=0

# Client chains (indexed 1..CLIENT_COUNT)
export CLIENT_COUNT=2

# Client 1 chain: Base mainnet
export CLIENT_1_RPC=${CLIENT_1_RPC:-https://mainnet.base.org}
export CLIENT_1_CHAIN_ID=8453
export CLIENT_1_CCTP_DOMAIN=6

# Client 2 chain: Arbitrum One
export CLIENT_2_RPC=${CLIENT_2_RPC:-https://arb1.arbitrum.io/rpc}
export CLIENT_2_CHAIN_ID=42161
export CLIENT_2_CCTP_DOMAIN=3

# Deployer private key — loaded from config/secrets.env (gitignored). For a Ledger deploy set
# DEPLOYER_LEDGER_ADDRESS instead and leave DEPLOYER_PRIVATE_KEY unset (docs/ledger-deploy.md).
# Fund it for gasLimit x maxFeePerGas per tx, not just gas used: mainnet networks run
# with gasMultiplier 2.0 (hardhat.config.ts) so slot-clearing admin calls cannot OOG.

# ============================================================================
# Circle CCTP V2 Contract Addresses (all chains)
# ============================================================================
# Required by the crowdfund launch: deploy_mainnet.ts step 1 validates these and
# records them with hub USDC in the hub CCTP manifest, which the crowdfund reads
# for USDC and the shielded-pool launch later reuses (#535).
# Same address on Ethereum, Base and Arbitrum. Source:
# https://developers.circle.com/cctp/evm-smart-contracts — verified on-chain on
# all three chains (localDomain matches the CCTP domains above; messenger ↔
# transmitter ↔ minter links agree; USDC.isMinter(TokenMinterV2) is true).
export CCTP_TOKEN_MESSENGER=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
export CCTP_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
export CCTP_TOKEN_MINTER=0xfd78EE919681417d192449715b2594ab58f5D002

# ============================================================================
# USDC Addresses (verify against Circle's official docs before use)
# ============================================================================
# Ethereum mainnet USDC (native Circle USDC)
export HUB_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Base mainnet USDC
export CLIENT_1_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Arbitrum One USDC
export CLIENT_2_USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ============================================================================
# Circle Iris Attestation Service (production — shielded-pool launch)
# ============================================================================
export IRIS_API_URL=https://iris-api.circle.com
export IRIS_POLL_INTERVAL_MS=10000
export IRIS_POLL_TIMEOUT_MS=600000
export VITE_IRIS_ATTESTATION_BASE_URL=https://iris-api.circle.com/attestations

# ============================================================================
# Aave Config (shielded-pool launch, not crowdfund)
# ============================================================================
# TODO (required before SHIELDED-POOL launch): set the production yield source /
# rate. The local default (5,000,000 bps) is a fast-forward testing value and is
# NOT valid for mainnet.
# export AAVE_YIELD_BPS=

# ============================================================================
# Governance Config
# ============================================================================
# Production timelock delay: 2 days (= the Governor's MIN_EXECUTION_DELAY / updateDelay cap).
# With HARDEN_TIMELOCK on (below), the timelock is deployed at delay 0 and raised to this
# value as the final bootstrap op (issue #347). This is the post-bootstrap target delay.
export TIMELOCK_DELAY=172800

# Timelock harden profile (issue #347): deploy at delay 0, deployer temporarily holds
# PROPOSER/EXECUTOR/CANCELLER to bootstrap all timelock-only wiring, raise the delay to
# TIMELOCK_DELAY, then renounce every deployer timelock role. Defaults to true on mainnet;
# set explicitly here for clarity. The config refuses HARDEN_TIMELOCK=false on mainnet.
export HARDEN_TIMELOCK=true

# Treasury outflow limits (#348): applied at deploy via initOutflowConfig, one-shot per
# token. Values from GOVERNANCE.md §Treasury Outflow Limits. Effective limit per rolling
# window = max(ABSOLUTE, BPS × treasury balance), never below FLOOR. FLOOR is fixed at
# deploy and can never be changed (no setter); governance can lower ABSOLUTE only down to it.
# A zero FLOOR lets governance tighten ABSOLUTE all the way to 0. Amounts in smallest units
# (USDC 6dp, ARM/ETH 18dp).
# USDC: 30-day window, 10%, 100,000 USDC absolute, no floor.
export OUTFLOW_USDC_WINDOW=2592000
export OUTFLOW_USDC_BPS=1000
export OUTFLOW_USDC_ABSOLUTE=100000000000
export OUTFLOW_USDC_FLOOR=0
# ARM: 30-day window, 3%, 250,000 ARM absolute, no floor.
export OUTFLOW_ARM_WINDOW=2592000
export OUTFLOW_ARM_BPS=300
export OUTFLOW_ARM_ABSOLUTE=250000000000000000000000
export OUTFLOW_ARM_FLOOR=0
# ETH (address(0)): 30-day window, 10%, 25 ETH absolute, no floor.
export OUTFLOW_ETH_WINDOW=2592000
export OUTFLOW_ETH_BPS=1000
export OUTFLOW_ETH_ABSOLUTE=25000000000000000000
export OUTFLOW_ETH_FLOOR=0

# ============================================================================
# Wind-down (#381 C2)
# ============================================================================
# The deadline is baked into ArmadaWindDown at this deploy. After it passes, anyone can
# trigger the terminal wind-down if recognized revenue is below the threshold — and
# revenue stays at 0 until the shielded-pool fee module ships. Choose a date that covers
# the shielded-pool launch plus a revenue ramp; governance can move it later (Standard
# proposal, setWindDownDeadline). No default on mainnet — the deploy fails without it.
# Decided value (specs/PARAMETER_MANIFEST.md §8.2):
export WINDDOWN_DEADLINE=2027-12-31T00:00:00Z
# Revenue threshold in whole USD ($10,000 cumulative, GOVERNANCE.md §Wind-Down). No default
# on mainnet — the deploy fails without it. Decided value (specs/PARAMETER_MANIFEST.md §8.2):
export WINDDOWN_REVENUE_THRESHOLD=10000

# ============================================================================
# ARM Token Distribution (12M total) — protocol constants, set explicitly
# ============================================================================
export ARM_TREASURY_ALLOCATION=7800000
export ARM_CROWDFUND_ALLOCATION=1800000
export ARM_REVENUE_LOCK_ALLOCATION=2400000

# ============================================================================
# RevenueLock ratchet rate cap (#530)
# ============================================================================
# MAX_REVENUE_INCREASE_PER_DAY in WHOLE USD (scaled to 18 decimals at deploy) — immutable
# per RevenueLock. $10k/day = spec value (issue #225): a malicious RevenueCounter upgrade
# needs >= 100 days to walk $0 -> $1M full unlock, assuming syncObservedRevenue() runs daily.
# Decided value (specs/PARAMETER_MANIFEST.md §8.2):
export REVENUE_LOCK_MAX_INCREASE_PER_DAY_USD=10000

# ============================================================================
# RevenueLock Beneficiaries (#144)
# ============================================================================
# The finalized mainnet beneficiary list. It lists the DIRECT beneficiaries only, without an
# entry for the reserve: amounts (whole ARM, no decimals) plus REVENUE_RESERVE_AMOUNT must sum
# exactly to ARM_REVENUE_LOCK_ALLOCATION, or the deploy refuses before its first transaction.
# Labels must be neutral ("beneficiary 001", in list order): the deploy prints every label, and
# the pre-commit hook refuses any other label. The list that maps those numbers to names is
# kept outside the repo, never committed. This file is also gitignored.
export REVENUE_LOCK_BENEFICIARIES_FILE=config/revenue-lock-beneficiaries-mainnet.json

# ============================================================================
# Revenue Reserve (required — specs/REVENUE_RESERVE_DISTRIBUTOR.md, #582)
# ============================================================================
# RevenueReserveDistributor is one RevenueLock beneficiary holding the reserve cap; the
# allocator Safe assigns irrevocable grants from it after launch. Both values are immutable
# distributor constructor inputs and are required on mainnet (the config refuses to build
# without them). The allocator must be a deployed Safe with exactly three distinct owners and
# threshold two, and must differ from the deployer, security council and launch team (checked
# on-chain before the first transaction).
# Allocator Safe address.
export REVENUE_RESERVE_ALLOCATOR=0x4932ad7d2317f450eE4Cc479456Fd64963b516C6
# Reserve cap in WHOLE ARM (approved cap-table amount, see the PARAMETER_MANIFEST.md
# "Reserve cap" row; 360000 is a worked example only).
export REVENUE_RESERVE_AMOUNT=402950

# ============================================================================
# Treasury — do NOT set TREASURY_ADDRESS on mainnet
# ============================================================================
# TREASURY_ADDRESS only overrides the privacy pool fee recipient (shielded-pool launch),
# which is fixed at PrivacyPool.initialize(). On mainnet that recipient must be the
# governance treasury (ArmadaTreasuryGov) read from the governance manifest, so the
# config refuses any value here. Crowdfund proceeds always go to ArmadaTreasuryGov.

# ============================================================================
# Security Council (required — 2-of-3 Safe, must differ from deployer and launch team)
# ============================================================================
# Holds crowdfund cancel authority and the Governor veto. The deploy refuses anything but a
# deployed multisig reporting exactly three distinct owners and threshold two.
export SECURITY_COUNCIL_ADDRESS=0x6F55B92B40c3F3cE41c50b50f4AD3a41D37B6D3f

# ============================================================================
# Initial Treasury Steward + USDC steward budget (#221, #222)
# ============================================================================
# Elected at deploy (TreasurySteward.electSteward) and given its USDC budget
# (treasury.addStewardBudgetToken) inside the timelock bootstrap window. Required on
# mainnet — the config refuses to build without INITIAL_STEWARD_ADDRESS.
# The steward must be a deployed Safe with exactly three distinct owners and threshold two,
# distinct from the deployer, security council, launch team and reserve allocator (checked
# on-chain before the first transaction). The 180-day term starts at the deploy block.
# Accepted risk: nobody holds voting power during the sale, so steward spend proposals made
# then cannot be voted down; the bound is one budget per window and the security council veto.
# Launch-team policy: no steward proposals until the post-finalize quiet period has ended.
export INITIAL_STEWARD_ADDRESS=0x966352D336FDf5De28D06D5fCbda41C2Be30f781
# Budget in WHOLE USDC per rolling window (scaled by 6 decimals at deploy); must not exceed
# the USDC outflow absolute limit. Spec value: $60,000 per 30 days (GOVERNANCE.md §Treasury
# Steward). Decided value (specs/PARAMETER_MANIFEST.md §8.2):
export STEWARD_BUDGET_USDC=60000
export STEWARD_BUDGET_WINDOW=2592000

# ============================================================================
# Launch Team (required — 1-of-3 Safe, must differ from deployer and security council)
# ============================================================================
# Issues crowdfund seeds and direct invites during the window (issue #218). The deploy refuses
# anything but a deployed multisig reporting exactly three distinct owners and threshold one
# or two. Intended: 1-of-3, every signer on a hardware wallet. Any one signer can act alone,
# including changing the Safe's owners, so a single lost key holds the role until the window
# closes; the security council's cancel() is the only stop.
export LAUNCH_TEAM_ADDRESS=0xB81B908219F93976f522df3DB9083B46045983E5

# ============================================================================
# Crowdfund Config
# ============================================================================
# Absolute open time (ISO 8601 UTC, whole seconds, trailing Z) — becomes the crowdfund's
# immutable windowStart. Must be the announced launch time. Required on mainnet; the
# orchestrator refuses to start unless it is 6h-60d away (CROWDFUND_OPEN_DELAY is ignored).
# Seeds can only be added at/after this time (during the launch-team window, which spans the full commitment window).
export CROWDFUND_OPEN_TIME=2026-10-08T16:00:00Z
# Shortens the 6h minimum lead above (whole seconds, hard floor 3600). Unset or empty = 6h.
# Set to 1h for Launch 1: the Sepolia rehearsal signed in about 20 minutes, and the
# announced open time is fixed. The launch-plan banner shows "OVERRIDE" while it is set.
export CROWDFUND_OPEN_MIN_LEAD_SECONDS=3600

# ============================================================================
# Relayer / Frontend (shielded-pool launch, not crowdfund)
# ============================================================================
export RELAYER_PORT=3001
# TODO (required before SHIELDED-POOL launch): real ETH/USDC price source.
export ETH_USDC_PRICE=2000
export BROADCASTER_RAILGUN_ADDRESS=
# TODO (frontend): WalletConnect project ID for mainnet.
# export VITE_WALLETCONNECT_PROJECT_ID=
