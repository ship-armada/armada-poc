# ABOUTME: Environment template for the crowdfund indexer Docker Compose stack.
# ABOUTME: Copy to `.env` next to docker-compose.yml and fill in real values.

# --- Compose orchestration ---------------------------------------------------
# Image tag to run. Build it first (see README) and tag it with the git SHA, e.g.
# crowdfund-indexer:<git-sha> — never a mutable tag like :latest, so the running code is
# identifiable and rollback is a tag change. Compose refuses to start while this is empty.
INDEXER_IMAGE=
# Seconds between Discord alert evaluations (alerts loop container).
CROWDFUND_ALERT_INTERVAL_SECONDS=60

# --- Crowdfund target --------------------------------------------------------
# Chain the indexer ingests: 1 = Ethereum mainnet, 11155111 = Sepolia. Required — it must
# match the network of CROWDFUND_CONTRACT_ADDRESS, and the indexer refuses to start if a
# configured RPC reports a different chain.
CROWDFUND_CHAIN_ID=
CROWDFUND_CONTRACT_ADDRESS=
CROWDFUND_TREASURY_ADDRESS=
CROWDFUND_USDC_ADDRESS=
# Required outside local Anvil: the crowdfund manifest's deployBlock
# (deployments/crowdfund-hub-<env>.json). 0 would backfill from genesis; the indexer refuses it.
CROWDFUND_DEPLOY_BLOCK=
# Primary ingestion RPC (required) + independent audit RPC (recommended). On mainnet
# use a dedicated provider (e.g. Alchemy/Infura), NOT a public node — the indexer
# polls continuously and public endpoints rate-limit. Use two different providers so
# the audit cross-check stays independent of the ingestion RPC.
CROWDFUND_PRIMARY_RPC_URL=
CROWDFUND_AUDIT_RPC_URL=

# --- Indexer API -------------------------------------------------------------
CROWDFUND_INDEXER_PORT=3002

# --- Store (default: Postgres) -----------------------------------------------
# The postgres service always runs with the stack. The URL must embed the same password as
# POSTGRES_PASSWORD below (URL-encode special characters), e.g.
#   postgres://crowdfund:<password>@postgres:5432/crowdfund
# POSTGRES_USER / POSTGRES_DB default to "crowdfund".
CROWDFUND_INDEXER_STORE=postgres
CROWDFUND_DATABASE_URL=
# File store (development/testing only): set CROWDFUND_INDEXER_STORE=file; it persists
# under /app/data (the `indexer-data` volume) at this path.
CROWDFUND_INDEXER_STORE_PATH=data/crowdfund-indexer/store.json

# --- Polling -----------------------------------------------------------------
CROWDFUND_POLL_ON_START=true
CROWDFUND_POLL_INTERVAL_MS=15000
CROWDFUND_CONFIRMATION_DEPTH=12

# --- Snapshots (default: local file under the data volume) -------------------
CROWDFUND_PUBLISH_ON_POLL=true
CROWDFUND_SNAPSHOT_PUBLISHER=file
CROWDFUND_SNAPSHOT_DIR=data/crowdfund-indexer/snapshots
# For S3/R2 fallback snapshots, see ../sample.env.production for the full var set.

# --- Alert window timestamps (unix seconds; read from the deployed contract) --
CROWDFUND_OPEN_TIMESTAMP=
CROWDFUND_WEEK1_DEADLINE=
CROWDFUND_COMMITMENT_DEADLINE=

# --- Discord alert webhooks (secrets — one URL per severity) -----------------
# Required on mainnet: a severity with no webhook is only logged to stderr.
CROWDFUND_ALERT_WEBHOOK_P0=
CROWDFUND_ALERT_WEBHOOK_P1=
CROWDFUND_ALERT_WEBHOOK_P2=
CROWDFUND_ALERT_WEBHOOK_P3=
CROWDFUND_ALERT_STATE_FILE=data/crowdfund-indexer/alerts.json

# --- Postgres service ---------------------------------------------------------
# Required — compose refuses to start without it. Use a long random value. The DB port is
# not published; it is only reachable on the compose network.
POSTGRES_PASSWORD=
